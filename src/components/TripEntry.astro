---
// 메인 목록의 여행 한 편 — 매거진 피처 기사처럼: 큰 번호, 표지, 제목, 숫자, 경로 그림
import Photo from './Photo.astro';
import RouteGlyph from './RouteGlyph.astro';
import { tripStats, ymd, pad2, type Trip } from '../lib/trip';

interface Props {
  trip: Trip;
  index: number;
}
const { trip, index } = Astro.props;
const t = trip.data;
const hero = trip.days.find((d) => d.data.day === t.heroDay)!;
const stats = tripStats(trip.days);
const href = `/trips/${trip.slug}/`;
const fmt = (n: number) => n.toLocaleString('en-US');
---

<article class:list={['entry', 'reveal', { flip: index % 2 === 1 }]} style={`--accent:${hero.data.tone.accent}`}>
  <a class="cover" href={href} tabindex="-1" aria-hidden="true">
    {hero.data.cover && <Photo photo={hero.data.cover} tone={hero.data.tone} class="cover-img" static />}
    <RouteGlyph trip={trip} class="cover-glyph" />
  </a>

  <div class="text">
    <p class="num" aria-hidden="true">{pad2(index + 1)}</p>
    <p class="eyebrow">
      {t.country} · {ymd(t.start)} — {ymd(t.end)}
    </p>
    <h2>
      <a href={href}>{t.title}</a>
    </h2>
    <p class="sub">{t.subtitle}</p>
    <p class="ko">{t.subtitleKo}</p>

    <dl class="stats">
      <div><dt>days</dt><dd>{stats.days}</dd></div>
      <div><dt>km</dt><dd>~{fmt(stats.km)}</dd></div>
      {stats.maxElevation > 0 && <div><dt>m peak</dt><dd>{fmt(stats.maxElevation)}</dd></div>}
      <div><dt>places</dt><dd>{stats.places}</dd></div>
    </dl>

    <a class="open" href={href}>Open the journal <span aria-hidden="true">→</span></a>
  </div>
</article>

<style>
  .entry {
    display: grid;
    grid-template-columns: 7fr 5fr;
    gap: clamp(28px, 5vw, 80px);
    align-items: end;
  }
  .entry.flip {
    grid-template-columns: 5fr 7fr;
  }
  .entry.flip .cover {
    order: 2;
  }

  .cover {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-2);
  }
  .cover :global(.cover-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: saturate(0.9) brightness(0.85);
    transition: transform 1.6s var(--ease-out), filter 0.8s;
  }
  .cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top right, rgb(0 0 0 / 0.75), transparent 55%);
  }
  .entry:hover .cover :global(.cover-img) {
    transform: scale(1.04);
    filter: saturate(1) brightness(1);
  }
  .cover :global(.cover-glyph) {
    position: absolute;
    z-index: 1;
    left: 20px;
    bottom: 20px;
    width: clamp(88px, 12vw, 140px);
    height: auto;
    filter: drop-shadow(0 1px 6px rgb(0 0 0 / 0.8));
  }

  .text {
    position: relative;
  }
  .num {
    font-family: var(--serif-display);
    font-weight: 900;
    font-style: italic;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(96px, 14vw, 200px);
    line-height: 0.8;
    margin: 0 0 20px;
    color: transparent;
    -webkit-text-stroke: 1.5px var(--accent);
  }
  .eyebrow {
    color: var(--accent);
    margin: 0;
  }
  h2 {
    font-family: var(--serif-display);
    font-weight: 900;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(48px, 7vw, 104px);
    line-height: 0.9;
    letter-spacing: -0.02em;
    margin: 10px 0 0;
  }
  h2 a {
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) left bottom / 0 2px no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }
  .entry:hover h2 a,
  h2 a:focus-visible {
    background-size: 100% 2px;
  }
  .sub {
    font-family: var(--serif-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(18px, 2vw, 24px);
    margin: 12px 0 0;
    color: #d9d3c8;
  }
  .ko {
    font-family: var(--serif);
    color: var(--film-dim);
    margin: 4px 0 0;
  }

  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 28px;
    margin: 28px 0 0;
    padding-top: 18px;
    border-top: 1px solid #2a2a2e;
  }
  .stats div {
    display: grid;
  }
  .stats dd {
    order: -1;
    margin: 0;
    font-family: var(--serif-display);
    font-weight: 300;
    font-size: clamp(26px, 3vw, 36px);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .stats dt {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin-top: 6px;
  }

  .open {
    display: inline-block;
    margin-top: 28px;
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--film);
  }
  .open span {
    display: inline-block;
    color: var(--accent);
    transition: transform 0.4s var(--ease-out);
  }
  .entry:hover .open span {
    transform: translateX(6px);
  }

  @media (max-width: 860px) {
    .entry,
    .entry.flip {
      grid-template-columns: 1fr;
    }
    .entry.flip .cover {
      order: 0;
    }
    .num {
      position: absolute;
      top: 0;
      right: 0;
      margin: 0;
      transform: translateY(-70%);
      font-size: 96px;
    }
  }
</style>
