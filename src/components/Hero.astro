---
import Photo from './Photo.astro';
import { TRIP, type Day } from '../lib/trip';

interface Props {
  cover: Day;
}
const { cover } = Astro.props;
---

<header class="hero">
  <div class="hero-media">
    {cover.data.cover && <Photo photo={cover.data.cover} day={cover.data.day} class="hero-img" static eager />}
  </div>
  <div class="bar bar-top" aria-hidden="true"></div>
  <div class="bar bar-bottom" aria-hidden="true"></div>

  <div class="hero-meta hero-meta-top">
    <span class="eyebrow">A Travel Journal — {TRIP.country}</span>
    <span class="eyebrow">{TRIP.base[1].toFixed(4)}° N · {TRIP.base[0].toFixed(4)}° E</span>
  </div>

  <div class="hero-title">
    <p class="kicker">{TRIP.subtitle}</p>
    <h1>
      {[...TRIP.title].map((ch, i) => <span style={`--i:${i}`}>{ch}</span>)}
    </h1>
    <p class="ko">{TRIP.subtitleKo}</p>
  </div>

  <div class="hero-meta hero-meta-bottom">
    <span class="eyebrow">{TRIP.start} — {TRIP.end}</span>
    <a class="eyebrow scroll-cue" href="#stats">Scroll <span aria-hidden="true">↓</span></a>
  </div>
</header>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: var(--ink);
  }
  .hero-media {
    position: absolute;
    inset: 0;
    animation: kenburns 24s ease-out both;
  }
  .hero-media :global(.hero-img) {
    width: 100%;
    height: 100%;
  }
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at center, transparent 30%, rgb(0 0 0 / 0.7) 100%),
      linear-gradient(to bottom, rgb(0 0 0 / 0.2), rgb(0 0 0 / 0.55));
  }
  @keyframes kenburns {
    from { transform: scale(1.18) translate3d(0, 2%, 0); filter: brightness(0.3); }
    to { transform: scale(1.02); filter: brightness(1); }
  }

  /* 시네마 레터박스 — 로드 시 열린다 */
  .bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    background: #000;
    z-index: 2;
    animation: letterbox 1.8s 0.2s var(--ease-out) forwards;
  }
  .bar-top { top: 0; }
  .bar-bottom { bottom: 0; }
  @keyframes letterbox {
    to { height: 9vh; }
  }

  .hero-title {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: 0 var(--gutter);
  }
  .kicker {
    font-family: var(--serif-display);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(16px, 2vw, 22px);
    margin: 0 0 0.4em;
    opacity: 0;
    animation: fade 1.4s 1.6s forwards;
  }
  h1 {
    font-family: var(--serif-display);
    font-weight: 900;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(64px, 17vw, 260px);
    line-height: 0.85;
    letter-spacing: -0.03em;
    margin: 0;
    display: flex;
    justify-content: center;
  }
  h1 span {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.3em);
    filter: blur(12px);
    animation: letter 1.4s calc(1s + var(--i) * 0.09s) var(--ease-out) forwards;
  }
  @keyframes letter {
    to { opacity: 1; transform: none; filter: blur(0); }
  }
  .ko {
    font-family: var(--serif);
    font-size: clamp(15px, 1.6vw, 19px);
    letter-spacing: 0.3em;
    margin: 1.2em 0 0;
    opacity: 0;
    animation: fade 1.4s 2s forwards;
  }
  @keyframes fade {
    to { opacity: 1; }
  }

  .hero-meta {
    position: absolute;
    z-index: 3;
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 12px;
    opacity: 0;
    animation: fade 1s 2.2s forwards;
  }
  .hero-meta-top { top: calc(9vh - 28px); }
  .hero-meta-bottom { bottom: calc(9vh - 28px); }
  .hero-meta .eyebrow { color: #cfc9be; }
  .scroll-cue {
    text-decoration: none;
  }
  .scroll-cue span {
    display: inline-block;
    animation: bob 2s infinite;
  }
  @keyframes bob {
    50% { transform: translateY(4px); }
  }

  @media (max-width: 640px) {
    .hero-meta-top { flex-direction: column; gap: 2px; }
  }
</style>
