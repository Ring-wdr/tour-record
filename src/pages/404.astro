---
import Base from '../layouts/Base.astro';
---

<Base title="404 — ALMATY" description="페이지를 찾을 수 없습니다.">
  <main class="nf">
    <p class="eyebrow">404 · Lost in the steppe</p>
    <h1>길을 잃었다.</h1>
    <a href="/">처음으로 돌아가기 →</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100svh;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 16px;
    padding: 0 var(--gutter);
  }
  h1 {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(32px, 6vw, 64px);
    margin: 0;
  }
  a {
    font-family: var(--mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--accent);
    text-decoration: none;
  }
</style>
