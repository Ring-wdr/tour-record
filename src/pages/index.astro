---
// 여행 목록. 지금은 최소한의 목록 — 메인 화면 디자인은 따로 작업한다
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { SITE } from '../lib/site';
import { getTrips, ymd } from '../lib/trip';

const trips = await getTrips();
const covers = trips.map((t) => t.days.find((d) => d.data.day === t.data.heroDay)!);
---

<Base title={SITE.title} description={`${SITE.titleKo} — ${trips.map((t) => t.data.title).join(' · ')}`}>
  <main class="index">
    <header>
      <p class="eyebrow">{SITE.titleKo}</p>
      <h1>{SITE.title}</h1>
    </header>
    <ul>
      {
        trips.map((trip, i) => (
          <li style={`--accent:${covers[i].data.tone.accent}`}>
            <a href={`/trips/${trip.slug}/`}>
              {covers[i].data.cover && <Photo photo={covers[i].data.cover!} tone={covers[i].data.tone} class="cover" static />}
              <span class="meta">
                <span class="eyebrow">
                  {trip.data.country} · {ymd(trip.data.start)} — {ymd(trip.data.end)}
                </span>
                <span class="title">{trip.data.title}</span>
                <span class="sub">{trip.data.subtitleKo}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</Base>

<style>
  .index {
    min-height: 100svh;
    padding: clamp(64px, 12vh, 140px) var(--gutter);
  }
  h1 {
    font-family: var(--serif-display);
    font-weight: 900;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(40px, 8vw, 96px);
    line-height: 0.9;
    margin: 8px 0 0;
  }
  ul {
    list-style: none;
    margin: 48px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
    gap: 24px;
  }
  a {
    position: relative;
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    background: #111;
  }
  a :global(.cover) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: transform 1.2s var(--ease-out);
  }
  a:hover :global(.cover) {
    transform: scale(1.04);
  }
  a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.85), transparent 55%);
  }
  .meta {
    position: absolute;
    z-index: 1;
    inset: auto 0 0;
    display: grid;
    gap: 4px;
    padding: 24px;
  }
  .meta .eyebrow {
    color: var(--accent);
  }
  .title {
    font-family: var(--serif-display);
    font-weight: 900;
    font-size: clamp(36px, 5vw, 56px);
    line-height: 1;
  }
  .sub {
    font-family: var(--serif);
    color: var(--film-dim);
  }
</style>
