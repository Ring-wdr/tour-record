---
import { pad2, type Day } from '../lib/trip';

interface Props {
  days: Day[];
  /** 제목 아래 설명 문구 */
  note?: string;
}
const { days, note } = Astro.props;
const accentOf = (day: number) => days.find((d) => d.data.day === day)!.data.tone.accent;

const W = 1000;
const H = 360;
const PAD = { top: 60, right: 30, bottom: 50, left: 30 };

// 고도가 없는 장소(인천 등)는 그래프에서 뺀다
const pts = days.flatMap((d) =>
  d.data.stops
    .filter((s) => s.elevation != null)
    .map((s) => ({ day: d.data.day, name: s.name, elev: s.elevation!, kind: s.kind })),
);
const lowest = Math.min(...pts.map((p) => p.elev));
const highest = Math.max(...pts.map((p) => p.elev));
// 그래프 천장: 최고점 위로 여유를 두고 500m 단위로 올림. 눈금은 4칸 이하가 되는 간격
const MAX = Math.ceil((highest + 300) / 500) * 500;
const tickStep = [100, 250, 500, 1000, 2000].find((s) => MAX / s <= 4) ?? 2000;
const ticks = Array.from({ length: Math.floor((MAX - 1) / tickStep) }, (_, i) => (i + 1) * tickStep);
const fmt = (n: number) => n.toLocaleString('en-US');
const step = (W - PAD.left - PAD.right) / (pts.length - 1);
const x = (i: number) => PAD.left + i * step;
const y = (e: number) => PAD.top + (1 - e / MAX) * (H - PAD.top - PAD.bottom);

const line = pts.map((p, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(p.elev).toFixed(1)}`).join(' ');
const area = `${line} L${x(pts.length - 1)},${H - PAD.bottom} L${x(0)},${H - PAD.bottom} Z`;

// 날짜가 바뀌는 지점 (고도 있는 장소가 없는 날은 건너뛴다)
const dayStarts = days
  .map((d) => ({ day: d.data.day, i: pts.findIndex((p) => p.day === d.data.day) }))
  .filter((d) => d.i >= 0);

// 라벨: 주변보다 두드러지는 지점부터 배치하고, 이미 놓인 라벨과 겹치면 건너뛴다.
// 봉우리는 점 위에, 골짜기는 점 아래에 단다.
const scored = pts.map((p, i) => {
  const prev = pts[i - 1]?.elev ?? p.elev;
  const next = pts[i + 1]?.elev ?? p.elev;
  return { ...p, i, stay: p.kind === 'stay', below: p.elev < prev && p.elev < next, score: Math.abs(p.elev - (prev + next) / 2) + p.elev * 0.05 };
});
const placed: { x: number; y: number }[] = [];
const labeled = scored
  .filter((p) => !p.stay)
  .sort((a, b) => b.score - a.score)
  .filter((p) => {
    const lx = x(p.i);
    const ly = y(p.elev) + (p.below ? 30 : -20);
    if (placed.some((q) => Math.abs(q.x - lx) < 78 && Math.abs(q.y - ly) < 34)) return false;
    placed.push({ x: lx, y: ly });
    return true;
  });
// 라벨에 쓰는 짧은 이름: "침블락 · 탈가르 패스" → "탈가르 패스", "샤슬릭 · Smile" → "샤슬릭"
const shortName = (n: string) => {
  const parts = n.split(' · ');
  return parts.length > 1 && /[가-힣]/.test(parts[1]) ? parts[1] : parts[0];
};
---

{pts.length >= 2 && (
<section class="alt" data-inview>
  <div class="alt-head reveal">
    <p class="eyebrow">The Altitude Line</p>
    <h2>{fmt(lowest)}m에서 {fmt(highest)}m까지</h2>
    {note && <p>{note}</p>}
  </div>

  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="여행 기간 방문지의 해발고도 변화">
    <defs>
      <linearGradient id="alt-fill" x1="0" x2="0" y1="0" y2="1">
        <stop offset="0" stop-color="#f2a65a" stop-opacity="0.45"></stop>
        <stop offset="1" stop-color="#f2a65a" stop-opacity="0"></stop>
      </linearGradient>
    </defs>

    {
      ticks.map((e) => (
        <g class="grid">
          <line x1={PAD.left} x2={W - PAD.right} y1={y(e)} y2={y(e)} />
          <text x={W - PAD.right} y={y(e) - 6} text-anchor="end">
            {e.toLocaleString('en-US')}m
          </text>
        </g>
      ))
    }

    {
      dayStarts.map(({ day, i }) => (
        <g class="day-sep">
          <line x1={x(i)} x2={x(i)} y1={PAD.top - 20} y2={H - PAD.bottom} />
          <text x={x(i) + 4} y={H - PAD.bottom + 20} fill={accentOf(day)}>
            D{pad2(day)}
          </text>
        </g>
      ))
    }

    <path class="area" d={area} fill="url(#alt-fill)"></path>
    <path class="line" d={line} pathLength="1"></path>

    {
      pts.map((p, i) => (
        <circle class="dot" cx={x(i)} cy={y(p.elev)} r="4" fill={accentOf(p.day)} style={`--d:${(i / pts.length) * 2.4}s`} />
      ))
    }
    {
      labeled.map((p) => (
        <g class="label" style={`--d:${(p.i / pts.length) * 2.4 + 0.2}s`}>
          <text x={x(p.i)} y={y(p.elev) + (p.below ? 22 : -26)} text-anchor="middle" class="l-name">
            {shortName(p.name)}
          </text>
          <text x={x(p.i)} y={y(p.elev) + (p.below ? 36 : -12)} text-anchor="middle" class="l-elev">
            {p.elev.toLocaleString('en-US')}
          </text>
        </g>
      ))
    }
  </svg>
</section>
)}

<style>
  .alt {
    position: relative;
    z-index: 2;
    background: var(--ink);
    padding: clamp(80px, 14vh, 160px) var(--gutter);
  }
  .alt-head {
    max-width: 640px;
  }
  .alt-head h2 {
    font-family: var(--serif);
    font-weight: 900;
    font-size: clamp(28px, 4vw, 48px);
    margin: 8px 0 12px;
  }
  .alt-head p:last-child {
    font-family: var(--serif);
    color: var(--film-dim);
  }
  svg {
    width: 100%;
    height: auto;
    margin-top: 40px;
    overflow: visible;
  }
  .grid line {
    stroke: #2a2a2e;
    stroke-dasharray: 2 4;
  }
  .grid text,
  .day-sep text {
    font-family: var(--mono);
    font-size: 11px;
    fill: #6f6a62;
  }
  .day-sep line {
    stroke: #222226;
  }
  .line {
    fill: none;
    stroke: #f2a65a;
    stroke-width: 2;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .area {
    opacity: 0;
  }
  .dot,
  .label {
    opacity: 0;
  }
  .l-name {
    font-family: var(--serif);
    font-size: 13px;
    fill: var(--film);
  }
  .l-elev {
    font-family: var(--mono);
    font-size: 10px;
    fill: #f2a65a;
  }
  .alt:global(.is-in) .line {
    transition: stroke-dashoffset 2.6s var(--ease-out);
    stroke-dashoffset: 0;
  }
  .alt:global(.is-in) .area {
    transition: opacity 1.5s 1.2s;
    opacity: 1;
  }
  .alt:global(.is-in) .dot,
  .alt:global(.is-in) .label {
    transition: opacity 0.6s var(--d);
    opacity: 1;
  }
  @media (max-width: 640px) {
    .label { display: none; }
  }
</style>
