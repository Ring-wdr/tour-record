---
import type { GetStaticPaths } from 'astro';
import FeatureTripPage from '../../../components/FeatureTripPage.astro';
import DayTripPage from '../../../daytrip/DayTripPage.astro';
import { getTrips, isFeature, type Trip } from '../../../lib/trip';

export const getStaticPaths = (async () => {
  const trips = await getTrips();
  return trips.map((trip) => ({ params: { slug: trip.slug }, props: { trip } }));
}) satisfies GetStaticPaths;

interface Props {
  trip: Trip;
}
const { trip } = Astro.props;
---

{/* 큰 여행은 시네마틱 스크롤리텔링, 단신 여행(국내 당일 등)은 한 페이지 전용 레이아웃 — src/daytrip/ */}
{isFeature(trip) ? <FeatureTripPage trip={trip} /> : <DayTripPage trip={trip} />}
