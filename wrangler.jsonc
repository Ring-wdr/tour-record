{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 여러 여행을 담는 사이트 — https://tour-record.page (workers.dev 주소도 계속 열려 있음)
  "name": "tour-record",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  // 커스텀 도메인 — 배포하면 DNS 레코드와 인증서를 Cloudflare가 만든다
  "routes": [{ "pattern": "tour-record.page", "custom_domain": true }],
  // 이미 공유된 workers.dev 링크도 계속 열리게
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // 사진은 dist에 넣지 않고(.assetsignore) R2 커스텀 도메인(photos.tour-record.page)에서 나간다.
    // Worker는 옛 사진 주소 /photos/*만 받아 그쪽으로 301 (worker/index.ts)
    "run_worker_first": ["/photos/*"]
  },
  // 키 = URL 경로 (photos/<slug>/dayXX/...). Worker는 쓰지 않지만 pnpm photos:upload·관리자가 이 버킷 이름을 읽는다
  "r2_buckets": [{ "binding": "PHOTOS", "bucket_name": "tour-record-photos" }]
}
