---
// 메인 목록의 단신 — 국내 당일 여행처럼 가벼운 여행 한 줄 (isFeature가 false). 큰 번호 없이 썸네일·제목·날짜·하루의 빛 띠.
// 장소 수와 띠는 여행 페이지(src/daytrip/)와 같은 시간축(moments)에서 — 목록과 페이지의 숫자가 같도록
import Photo from './Photo.astro';
import { ymd, type Trip } from '../lib/trip';
import { moments, numbered } from '../daytrip/lib';
import { skyAt } from '../daytrip/sky';

interface Props {
  trip: Trip;
}
const { trip } = Astro.props;
const t = trip.data;
const hero = trip.days.find((d) => d.data.day === t.heroDay)!;
const href = `/trips/${trip.slug}/`;
const when = t.start.getTime() === t.end.getTime() ? ymd(t.start) : `${ymd(t.start)} — ${ymd(t.end)}`;
const list = moments(trip);
const stops = numbered(list).length;
const first = list[0];
const last = list.at(-1)!;
const km = trip.days.reduce((n, d) => n + d.data.driveKm, 0);
// 하루의 빛 — 첫 장소부터 마지막 장소까지 30분마다 그 시각의 색 (페이지의 시계 막대·코다와 같은 띠), 눈금 = 장소
const spanMin = Math.max(1, last.min - first.min);
const at = (min: number) => `${(((min - first.min) / spanMin) * 100).toFixed(1)}%`;
const band = [...Array.from({ length: Math.floor(spanMin / 30) + 1 }, (_, i) => first.min + i * 30), last.min]
  .map((m) => `${skyAt(m).accent} ${at(m)}`)
  .join(', ');
---

<article class="brief reveal" style={`--accent:${hero.data.tone.accent}`}>
  <a class="cover" href={href} tabindex="-1" aria-hidden="true" data-vt-cover={trip.slug}>
    {hero.data.cover && <Photo photo={hero.data.cover} tone={hero.data.tone} class="cover-img" static />}
  </a>

  <div class="text">
    <p class="eyebrow">{t.country} · {when}</p>
    <h3><a href={href}>{t.subtitleKo}</a></h3>
    <p class="sub" lang="en">{t.subtitle}</p>
    <p class="meta">{stops} {stops === 1 ? 'stop' : 'stops'} · ~{km.toLocaleString('en-US')} km</p>
    <p class="light">
      <time>{first.time}</time>
      <span class="band" aria-hidden="true">
        <i style={`background:linear-gradient(90deg, ${band})`}></i>
        {list.map((m) => <b style={`left:${at(m.min)};background:${m.color}`}></b>)}
      </span>
      <time>{last.time}</time>
    </p>
  </div>
</article>

<style>
  .brief {
    display: grid;
    grid-template-columns: clamp(120px, 16vw, 200px) minmax(0, 1fr);
    gap: clamp(16px, 3vw, 36px);
    align-items: center;
    padding: 20px 0;
    border-top: 1px solid #222;
  }
  /* 표지 비율 = 여행 페이지 첫 화면 사진 칸의 비율(넓은 화면 ≈4:3, 좁은 화면 5:4) — 목록 → 페이지 전환에서
     커지는 동안 두 사진의 잘린 자리가 같아 이중 테두리가 생기지 않게 (src/daytrip/components/Opener.astro) */
  .cover {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--ink-2);
  }
  .cover :global(.cover-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    filter: saturate(0.85) brightness(0.85);
    transition:
      transform 1.2s var(--ease-out),
      filter 0.6s;
  }
  .brief:hover .cover :global(.cover-img) {
    transform: scale(1.05);
    filter: none;
  }
  .eyebrow {
    color: var(--accent);
    margin: 0;
  }
  h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.25;
    margin: 6px 0 0;
  }
  h3 a {
    text-decoration: none;
    background: linear-gradient(var(--accent), var(--accent)) left bottom / 0 1px no-repeat;
    transition: background-size 0.5s var(--ease-out);
  }
  .brief:hover h3 a,
  h3 a:focus-visible {
    background-size: 100% 1px;
  }
  .sub {
    margin: 2px 0 0;
    font-family: var(--serif-display);
    font-style: italic;
    font-weight: 300;
    font-size: 15px;
    line-height: 1.4;
    color: #cfc9be;
  }
  .meta {
    margin: 8px 0 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--film-dim);
  }

  /* 하루의 빛 — 여행 페이지의 시계 막대를 줄인 것. 줄 끝까지 — 한 줄의 오른쪽이 비어 보이지 않게 */
  .light {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 12px 0 0;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    font-variant-numeric: tabular-nums;
    color: var(--film-dim);
  }
  .band {
    position: relative;
    flex: 1;
    height: 9px;
  }
  .band i,
  .band b {
    position: absolute;
  }
  .band i {
    left: 0;
    right: 0;
    top: 3px;
    height: 3px;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 1.6s 0.2s var(--ease-out);
  }
  .band b {
    top: 0;
    width: 2px;
    height: 9px;
    margin-left: -1px;
    opacity: 0;
    transition: opacity 0.6s 1.2s;
  }
  :global(.is-in) .band i {
    transform: none;
  }
  :global(.is-in) .band b {
    opacity: 0.9;
  }

  @media (max-width: 899px) {
    .cover {
      aspect-ratio: 5 / 4;
    }
  }
  @media (max-width: 640px) {
    .brief {
      grid-template-columns: 112px minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
