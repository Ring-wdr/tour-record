---
import { SITE } from '../lib/site';
import { ymd, type Trip } from '../lib/trip';

interface Props {
  trip: Trip;
}
const t = Astro.props.trip.data;
---

<footer class="outro">
  <p class="fin reveal">Fin.</p>
  <div class="credits reveal">
    <span class="eyebrow">{t.title} · {ymd(t.start)} — {ymd(t.end)}</span>
    <span class="eyebrow">Written by {SITE.author}</span>
    <span class="eyebrow">Map © OpenStreetMap contributors · OpenFreeMap</span>
  </div>
</footer>

<style>
  .outro {
    position: relative;
    z-index: 2;
    background: #000;
    min-height: 80svh;
    display: grid;
    place-content: center;
    text-align: center;
    gap: 24px;
    padding: 80px var(--gutter);
  }
  .fin {
    font-family: var(--serif-display);
    font-style: italic;
    font-weight: 300;
    font-variation-settings: 'opsz' 144;
    font-size: clamp(64px, 12vw, 160px);
    line-height: 1;
    margin: 0;
  }
  .credits {
    display: grid;
    gap: 6px;
    margin-top: 40px;
  }
</style>
